@model IEnumerable<DuAnBanSachMVC.Models.Sach>

@{
    ViewBag.Title = "Quản lý Sách";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<style>
    :root {
        --primary-color: #5F9F90;
        --primary-hover: #4A8376;
        --bg-light: #F4F8F7;
    }

    .page-title {
        font-weight: 700;
        color: #2F3E46;
        border-left: 5px solid var(--primary-color);
        padding-left: 15px;
        margin-bottom: 25px;
        text-transform: uppercase;
        font-size: 24px;
    }

    /* Khung Card bọc bảng giống trang Thể loại */
    .content-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        background: #fff;
        padding: 25px;
    }

    /* Nút thêm mới danh mục */
    .btn-add-new {
        background-color: var(--primary-color) !important;
        color: #fff !important;
        border: none;
        border-radius: 20px;
        padding: 8px 20px;
        font-weight: 500;
        transition: background 0.2s;
        text-decoration: none;
    }

        .btn-add-new:hover {
            background-color: var(--primary-hover) !important;
            color: #fff !important;
        }

    /* Định dạng bảng */
    .table-custom thead {
        background-color: var(--bg-light);
        color: var(--primary-color);
    }

    .table-custom th {
        font-weight: 600;
        border: none;
    }

    /* Định dạng ảnh bìa sách nhỏ gọn */
    .book-cover {
        width: 50px;
        height: 70px;
        object-fit: cover;
        border-radius: 4px;
        box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }
</style>

<div class="container-fluid mt-4">

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show d-flex align-items-center" role="alert" style="border-radius: 8px; margin-bottom: 20px;">
            <i class="fa-solid @(TempData["AlertType"].ToString() == "success" ? "fa-circle-check" : "fa-circle-exclamation") mr-2" style="font-size: 20px;"></i>
            <div>@TempData["AlertMessage"]</div>
           
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title m-0">QUẢN LÝ DANH SÁCH SÁCH</h2>
        <a href="@Url.Action("Create")" class="btn btn-add-new">
            <i class="fa-solid fa-plus me-1"></i> Thêm sách mới
        </a>
    </div>

    <div class="content-card">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-custom align-middle">
                <thead>
                    <tr>
                        <th style="width: 8%;">Hình ảnh</th>
                        <th style="width: 25%;">Tên cuốn sách</th>
                        <th style="width: 15%;">Thể loại</th>
                        <th style="width: 12%;">Giá bán</th>
                        <th style="width: 10%;" class="text-center">Tồn kho</th>
                        <th style="width: 15%;" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">
                                @if (!string.IsNullOrEmpty(item.Anh_Bia_Url))
                                {
                                    <img src="@item.Anh_Bia_Url" class="book-cover" alt="Bìa sách" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/Content/Images/no-image.png")" class="book-cover" alt="Không có ảnh" />
                                }
                            </td>
                            <td class="font-weight-bold text-gray-800 align-middle">
                                @Html.DisplayFor(modelItem => item.Ten_Sach)
                            </td>
                            <td class="text-dark align-middle">
                                @Html.DisplayFor(modelItem => item.The_Loai.Ten_The_Loai)
                            </td>
                            <td class="text-danger font-weight-bold align-middle">
                                @(string.Format("{0:N0}", item.Gia_Ban)) đ
                            </td>
                            <td class="text-center align-middle">
                                @if (item.So_Luong_Ton <= 5)
                                {
                                    <span class="badge badge-danger">Sắp hết hàng (@item.So_Luong_Ton)</span>
                                }
                                else
                                {
                                    <span class="badge badge-success">@item.So_Luong_Ton</span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Edit", new { id = item.Ma_Sach })" class="btn btn-sm btn-outline-primary" title="Sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="@Url.Action("Details", new { id = item.Ma_Sach })" class="btn btn-sm btn-outline-info mx-1" title="Chi tiết">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Ma_Sach })" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>