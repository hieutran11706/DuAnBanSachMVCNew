@model DuAnBanSachMVC.Models.Don_Hang

@{
    ViewBag.Title = "Chi Tiết Đơn Hàng";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<style>
    :root {
        --primary-color: #5F9F90;
        --primary-hover: #4A8376;
    }

    .page-title {
        font-weight: 700;
        color: #2F3E46;
        border-left: 5px solid var(--primary-color);
        padding-left: 15px;
        text-transform: uppercase;
        font-size: 22px;
    }

    .card-custom {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .info-title {
        font-weight: 600;
        color: #6c757d;
        font-size: 13px;
        text-transform: uppercase;
    }

    .info-content {
        font-size: 16px;
        font-weight: 700;
        color: #2F3E46;
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        border-radius: 20px;
        padding: 8px 20px;
        font-weight: 600;
        color: var(--primary-color) !important;
        border: 1.5px solid var(--primary-color);
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-back:hover {
            background-color: var(--primary-color);
            color: #fff !important;
        }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle mr-2"></i> @TempData["Success"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-circle mr-2"></i> @TempData["Error"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<div class="container-fluid mt-4" style="max-width: 1000px;">
    <div class="mb-4">
        <h2 class="page-title m-0">Chi Tiết Đơn Hàng</h2>
        <p class="text-muted m-0 mt-1 small">Chi tiết các mặt hàng sách và thông tin thanh toán của hóa đơn.</p>
    </div>

    <div class="card card-custom mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="font-weight-bold text-dark m-0"><i class="fas fa-truck text-muted mr-2"></i>Thông tin đơn hàng</h5>
        </div>
        <div class="card-body p-4">
            <div class="row">
                <div class="col-md-3 mb-3">
                    <div class="info-title">Mã Đơn Hàng</div>
                    <div class="badge px-3 py-2 mt-1" style="background-color: #E6F2F0; color: var(--primary-color); font-family: monospace; font-size: 14px;">
                        #@Model.Ma_Don_Hang
                    </div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="info-title">Khách hàng đặt</div>
                    <div class="info-content mt-1">@Model.Khach_Hang.Ho_Ten</div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="info-title">Số điện thoại</div>
                    <div class="info-content mt-1">@Model.Khach_Hang.So_Dien_Thoai</div>
                </div>
                <div class="col-md-3 mb-3">
                    <div class="info-title">Ngày đặt</div>
                    <div class="info-content mt-1">@Model.Ngay_Dat.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="col-md-6 mt-2">
                    <div class="info-title">Địa chỉ giao hàng</div>
                    <div class="info-content mt-1 text-secondary font-weight-normal">@Model.Dia_Chi_Giao_Hang</div>
                </div>
                <div class="col-md-6 mt-2">
                    <div class="info-title">Trạng thái xử lý</div>
                    <div class="info-content mt-1">
                        @if (Model.Trang_Thai == "Chờ xử lý")
                        {
                            <span class="badge badge-warning text-dark px-3 py-2" style="font-size: 14px;">Chờ xử lý</span>
                        }
                        else if (Model.Trang_Thai == "Đang giao")
                        {
                            <span class="badge badge-info text-white px-3 py-2" style="font-size: 14px;">Đang giao</span>
                        }
                        else if (Model.Trang_Thai == "Đã giao")
                        {
                            <span class="badge badge-success text-white px-3 py-2" style="font-size: 14px;">Đã giao</span>
                        }
                        else
                        {
                            <span class="badge badge-danger text-white px-3 py-2" style="font-size: 14px;">@Model.Trang_Thai</span>
                        }

                        @using (Html.BeginForm("CapNhatTrangThai", "Don_Hang", FormMethod.Post, new { @class = "d-inline-block ml-3" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.Hidden("id", Model.Ma_Don_Hang)

                            <select name="trangThaiMoi" class="form-control-sm border-secondary align-middle" onchange="this.form.submit()" style="border-radius: 6px;">
                                <option value="">-- Cập nhật trạng thái --</option>
                                <option value="Chờ xử lý" @(Model.Trang_Thai == "Chờ xử lý" ? "selected" : "")>Chờ xử lý</option>
                                <option value="Đang giao" @(Model.Trang_Thai == "Đang giao" ? "selected" : "")>Đang giao</option>
                                <option value="Đã giao" @(Model.Trang_Thai == "Đã giao" ? "selected" : "")>Đã giao</option>
                                <option value="Đã hủy" @(Model.Trang_Thai == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                            </select>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-custom mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="font-weight-bold text-dark m-0"><i class="fas fa-book text-muted mr-2"></i>Danh sách sách đã đặt</h5>
        </div>
        <div class="card-body p-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr class="text-secondary" style="font-size: 14px;">
                            <th>Tên Sách</th>
                            <th class="text-center">Số lượng</th>
                            <th class="text-right">Đơn giá</th>
                            <th class="text-right">Thành tiền</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Chi_Tiet_Don_Hang)
                        {
                            <tr>
                                <td class="align-middle">
                                    <div class="font-weight-bold text-dark">
                                        @(item.Sach != null ? item.Sach.Ten_Sach : "Sách đã bị xóa hoặc không tìm thấy")
                                    </div>
                                    <small class="text-muted">Mã sản phẩm: @item.Ma_Sach</small>
                                </td>
                                <td class="text-center align-middle font-weight-bold">@item.So_Luong</td>

                                <td class="text-right align-middle">
                                    @item.Gia_Luc_Mua.ToString("N0") đ
                                </td>

                                <td class="text-right align-middle font-weight-bold text-dark">
                                    @((item.So_Luong * item.Gia_Luc_Mua).ToString("N0")) đ
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <hr class="my-4" />
            <div class="row justify-content-end">
                <div class="col-md-4 text-right">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng tiền hàng:</span>
                        <span class="font-weight-bold text-dark">@Model.Tong_Tien.ToString("N0") đ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Giảm giá:</span>
                        <span class="font-weight-bold text-success">- @Model.Tien_Giam_Gia.ToString("N0") đ</span>
                    </div>
                    <hr class="my-2" />
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="text-muted m-0" style="font-size: 15px;">THÀNH TIỀN:</h5>
                        <h3 class="text-danger font-weight-bold m-0">@Model.Thanh_Tien.ToString("N0") đ</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-5">
            <a href="@Url.Action("Index")" class="btn-back">
                <i class="fa-solid fa-arrow-left me-2"></i> Quay lại danh sách đơn hàng
            </a>

            @if (Model.Trang_Thai == "Chờ xử lý")
            {
                using (Html.BeginForm("CapNhatTrangThai", "Don_Hang", FormMethod.Post, new { onsubmit = "return confirm('Bạn có chắc chắn muốn HỦY đơn hàng này không?');" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.Hidden("id", Model.Ma_Don_Hang)
                    @Html.Hidden("trangThaiMoi", "Đã hủy")

                    <button type="submit" class="btn btn-sm btn-danger px-4 py-2 font-weight-bold" style="border-radius: 20px;">
                        <i class="fas fa-ban mr-1"></i> Hủy đơn hàng này
                    </button>
                }
            }
        </div>
    </div>
</div>