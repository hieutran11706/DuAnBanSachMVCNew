@model IEnumerable<DuAnBanSachMVC.Models.Don_Hang>

@{
    ViewBag.Title = "Quản Lý Đơn Hàng";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<style>
    :root {
        --primary-color: #5F9F90;
        --primary-hover: #4A8376;
        --bg-light: #F4F8F7;
    }

    .page-title {
        font-weight: 700;
        color: #2F3E46;
        border-left: 5px solid var(--primary-color);
        padding-left: 15px;
        text-transform: uppercase;
        font-size: 24px;
    }

    .card-custom {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .badge-id {
        background-color: #E6F2F0;
        color: var(--primary-color);
        font-weight: 700;
        padding: 6px 12px;
        border-radius: 6px;
        font-family: monospace;
    }

    .btn-view-detail {
        color: var(--primary-color) !important;
        border: 1.5px solid var(--primary-color);
        border-radius: 20px;
        font-weight: 600;
        padding: 5px 15px;
        transition: all 0.3s ease;
    }

        .btn-view-detail:hover {
            background-color: var(--primary-color);
            color: #fff !important;
        }

    .status-badge {
        font-weight: 600;
        padding: 5px 12px;
        border-radius: 15px;
        font-size: 13px;
    }
</style>

<div class="container-fluid mt-4">
    <div class="mb-4">
        <h2 class="page-title m-0">Quản Lý Đơn Hàng</h2>
        <p class="text-muted m-0 mt-1 small">Quản lý trạng thái và theo dõi đơn đặt hàng của khách.</p>
    </div>

    <div class="card card-custom mb-4">
        <div class="card card-custom mb-3" style="background-color: #F8F9FA;">
            <div class="card-body p-3">
                @using (Html.BeginForm("Index", "Don_Hang", FormMethod.Get, new { @class = "row align-items-center" }))
                {
                    <div class="col-md-4 mb-2 mb-md-0">
                        <input type="text" name="searchString" value="@Request.QueryString["searchString"]" class="form-control form-control-sm border-secondary" placeholder="Tìm theo Mã đơn hoặc Tên khách..." style="border-radius: 6px;" />
                    </div>

                    <div class="col-md-3 mb-2 mb-md-0">
                        <select name="statusFilter" class="custom-select custom-select-sm border-secondary" style="border-radius: 6px;">
                            <option value="">-- Tất cả trạng thái --</option>
                            <option value="Chờ xử lý" @(Request.QueryString["statusFilter"] == "Chờ xử lý" ? "selected" : "")>Chờ xử lý</option>
                            <option value="Đang giao" @(Request.QueryString["statusFilter"] == "Đang giao" ? "selected" : "")>Đang giao</option>
                            <option value="Đã giao" @(Request.QueryString["statusFilter"] == "Đã giao" ? "selected" : "")>Đã giao</option>
                            <option value="Đã hủy" @(Request.QueryString["statusFilter"] == "Đã hủy" ? "selected" : "")>Đã hủy</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-sm text-white px-3" style="background-color: var(--primary-color); border-radius: 6px; font-weight: 600;">
                            <i class="fas fa-filter mr-1"></i> Lọc kết quả
                        </button>
                        <a href="@Url.Action("Index")" class="btn btn-sm btn-light border-secondary ml-2" style="border-radius: 6px;">
                            Làm mới
                        </a>
                    </div>
                }
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover text-dark align-middle" width="100%">
                    <thead style="background-color: var(--bg-light); color: var(--primary-color);">
                        <tr>
                            <th>Mã Đơn</th>
                            <th>Khách Hàng</th>
                            <th>Ngày Đặt</th>
                            <th>Trạng Thái</th>
                            <th>Thành Tiền</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="align-middle"><span class="badge-id">#@item.Ma_Don_Hang</span></td>
                                <td class="align-middle font-weight-bold">@item.Khach_Hang.Ho_Ten</td>
                                <td class="align-middle">@item.Ngay_Dat.ToString("dd/MM/yyyy HH:mm")</td>
                                <td class="align-middle">
                                    @if (item.Trang_Thai == "Chờ xử lý")
                                    {
                                        <span class="status-badge bg-warning text-dark">Chờ xử lý</span>
                                    }
                                    else if (item.Trang_Thai == "Đang giao")
                                    {
                                        <span class="status-badge bg-info text-white">Đang giao</span>
                                    }
                                    else if (item.Trang_Thai == "Đã giao")
                                    {
                                        <span class="status-badge bg-success text-white">Đã giao</span>
                                    }
                                    else
                                    {
                                        <span class="status-badge bg-danger text-white">@item.Trang_Thai</span>
                                    }
                                </td>
                                <td class="align-middle text-danger font-weight-bold">
                                    @item.Thanh_Tien.ToString("N0") đ
                                </td>
                                <td class="text-center align-middle">
                                    <a href="@Url.Action("Details", new { id = item.Ma_Don_Hang })" class="btn btn-sm btn-view-detail">
                                        <i class="fas fa-eye mr-1"></i> Xem chi tiết
                                    </a>
                                </td>


                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
</div>