@model DuAnBanSachMVC.Models.Danh_Gia

@{
    ViewBag.Title = "Xác Nhận Xóa Đánh Giá";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<style>
    :root {
        --danger-color: #dc3545;
        --danger-hover: #bd2130;
    }

    .page-title {
        font-weight: 700;
        color: #2F3E46;
        border-left: 5px solid var(--danger-color);
        padding-left: 15px;
        text-transform: uppercase;
        font-size: 22px;
    }

    .card-custom {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
    }

    .btn-back {
        display: inline-flex;
        align-items: center;
        border-radius: 20px;
        padding: 8px 20px;
        font-weight: 600;
        color: #6c757d !important;
        border: 1.5px solid #6c757d;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-back:hover {
            background-color: #6c757d;
            color: #fff !important;
        }

    .btn-delete-confirm {
        border-radius: 20px;
        padding: 8px 25px;
        font-weight: 600;
        background-color: var(--danger-color);
        border: none;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-delete-confirm:hover {
            background-color: var(--danger-hover);
            box-shadow: 0 4px 10px rgba(220, 53, 69, 0.3);
        }
</style>

<div class="container mt-4" style="max-width: 750px;">
    <div class="mb-4">
        <h2 class="page-title m-0">Xác Nhận Xóa Đánh Giá</h2>
        <p class="text-muted m-0 mt-1 small text-danger">
            <i class="fas fa-exclamation-triangle mr-1"></i> Cảnh báo: Đánh giá sẽ bị xóa vĩnh viễn khỏi hệ thống và không thể khôi phục!
        </p>
    </div>

    <div class="card card-custom mb-4">
        <div class="card-header bg-white border-0 pt-4 px-4">
            <h5 class="font-weight-bold text-dark m-0">
                <i class="fas fa-comment-alt text-muted mr-2"></i>Nội dung chi tiết đánh giá
            </h5>
        </div>
        <div class="card-body p-4">
            @Html.Partial("_ChiTietDanhGiaPartial", Model)
        </div>
    </div>

    <div class="mb-5">
        @using (Html.BeginForm("Delete", "Danh_Gia", new { id = Model.Ma_Danh_Gia }, FormMethod.Post, new { @class = "d-flex justify-content-between align-items-center" }))
        {
            @Html.AntiForgeryToken()

            <a href="@Url.Action("Index")" class="btn-back">
                <i class="fas fa-arrow-left mr-2"></i> Quay lại danh sách
            </a>

            <button type="submit" class="btn-delete-confirm">
                <i class="fas fa-trash-alt mr-2"></i> Xác nhận xóa vĩnh viễn
            </button>
        }
    </div>
</div>