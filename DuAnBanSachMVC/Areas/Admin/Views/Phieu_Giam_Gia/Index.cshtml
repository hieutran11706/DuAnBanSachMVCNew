@model IEnumerable<DuAnBanSachMVC.Models.Phieu_Giam_Gia>

@{
    ViewBag.Title = "Quản Lý Phiếu Giảm Giá";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<style>
    :root {
        --primary-color: #5F9F90;
        --primary-hover: #4A8376;
        --bg-light: #F4F8F7;
    }

    .page-title {
        font-weight: 700;
        color: #2F3E46;
        border-left: 5px solid var(--primary-color);
        padding-left: 15px;
        margin-bottom: 25px;
        text-transform: uppercase;
        font-size: 24px;
    }

    .content-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        background: #fff;
        padding: 25px;
    }

    .btn-add-new {
        background-color: var(--primary-color) !important;
        color: #fff !important;
        border: none;
        border-radius: 20px;
        padding: 8px 20px;
        font-weight: 500;
        transition: background 0.2s;
        text-decoration: none;
    }

        .btn-add-new:hover {
            background-color: var(--primary-hover) !important;
            color: #fff !important;
        }

    .table-custom thead {
        background-color: var(--bg-light);
        color: var(--primary-color);
    }

    .table-custom th {
        font-weight: 600;
        border: none;
    }

    /* Các nhãn phân biệt mức giảm */
    .badge-percent {
        background-color: #E2F0D9;
        color: #385723;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 6px;
    }

    .badge-money {
        background-color: #FFF2CC;
        color: #7F6000;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 6px;
    }

    code {
        font-size: 110%;
        color: #e83e8c;
        background-color: #f8f9fa;
        padding: 2px 6px;
        border-radius: 4px;
        border: 1px dashed #e83e8c;
    }
</style>

<div class="container-fluid mt-4">

    @if (TempData["AlertMessage"] != null)
    {
        <div class="alert alert-@TempData["AlertType"] alert-dismissible fade show d-flex align-items-center" role="alert" style="border-radius: 8px; margin-bottom: 20px;">
            <i class="fa-solid @(TempData["AlertType"].ToString() == "success" ? "fa-circle-check" : "fa-circle-exclamation") mr-2" style="font-size: 20px;"></i>
            <div>@TempData["AlertMessage"]</div>
            <button type="button" class="close ml-auto" data-dismiss="alert" aria-label="Close" style="outline: none;">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="page-title m-0">QUẢN LÝ PHIẾU GIẢM GIÁ</h2>
        <a href="@Url.Action("Create")" class="btn btn-add-new">
            <i class="fa-solid fa-plus me-1"></i> Tạo phiếu mới
        </a>
    </div>

    <div class="content-card">
        <div class="table-responsive">
            <table class="table table-striped table-hover table-custom align-middle">
                <thead>
                    <tr>
                        <th>Mã Code (Voucher)</th>
                        <th>Loại Giảm</th>
                        <th>Mức Giảm</th>
                        <th>Đơn Hàng Tối Thiểu</th>
                        <th>Số Lượng Còn</th>
                        <th>Thời Hạn Áp Dụng</th>
                        <th>Trạng Thái</th>
                        <th class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="align-middle">
                                <code>@item.Code_Giam_Gia</code>
                            </td>
                            <td class="align-middle text-secondary font-weight-500">
                                @(item.Loai_Giam_Gia == "Phan_Tram" ? "Theo Phần Trăm" : "Theo Số Tiền")
                            </td>
                            <td class="align-middle">
                                @if (item.Loai_Giam_Gia == "Phan_Tram")
                                {
                                    <span class="badge-percent">Giảm @string.Format("{0:0}", item.Gia_Tri_Giam)%</span>
                                }
                                else
                                {
                                    <span class="badge-money">Giảm @string.Format("{0:N0}", item.Gia_Tri_Giam)đ</span>
                                }
                            </td>
                            <td class="align-middle font-weight-bold text-dark">
                                @string.Format("{0:N0}", item.Gia_Tri_Don_Hang_Toi_Thieu)đ
                            </td>
                            <td class="align-middle font-weight-bold">
                                @item.So_Luong_Con_Lai lượt
                            </td>
                            <td class="align-middle small text-muted">
                                @item.Ngay_Bat_Dau.ToString("dd/MM/yyyy") - @item.Ngay_Ket_Thuc.ToString("dd/MM/yyyy")
                            </td>
                            <td class="align-middle">
                                @if (item.Trang_Thai == "Hoat_Dong" && item.Ngay_Ket_Thuc >= DateTime.Today && item.So_Luong_Con_Lai > 0)
                                {
                                    <!-- Xanh lá nhạt - Chữ xanh đậm: Cực kỳ rõ ràng -->
                                    <span class="badge p-2 text-uppercase" style="background-color: #E2F0D9; color: #2E5B1E; border: 1px solid #C5E0B4; border-radius: 12px; font-weight: 600; font-size: 12px;">
                                        <i class="fa-solid fa-circle mr-1" style="font-size: 8px; vertical-align: middle;"></i> Đang hoạt động
                                    </span>
                                }
                                else if (item.Trang_Thai == "Tam_Khoa")
                                {
                                    <!-- Vàng cam nhạt - Chữ nâu cam đậm: Hết bị mờ chữ trắng -->
                                    <span class="badge p-2 text-uppercase" style="background-color: #FFF2CC; color: #A66208; border: 1px solid #FCE4D6; border-radius: 12px; font-weight: 600; font-size: 12px;">
                                        <i class="fa-solid fa-pause mr-1" style="font-size: 9px; vertical-align: middle;"></i> Tạm khóa
                                    </span>
                                }
                                else
                                {
                                    <!-- Xám nhạt - Chữ xám tro đậm: Phân biệt rõ với các mã dùng được -->
                                    <span class="badge p-2 text-uppercase" style="background-color: #EDEDED; color: #595959; border: 1px solid #D9D9D9; border-radius: 12px; font-weight: 600; font-size: 12px;">
                                        <i class="fa-solid fa-circle-xmark mr-1" style="font-size: 10px; vertical-align: middle;"></i> Hết hạn/Hết lượt
                                    </span>
                                }
                            </td>
                            <td class="text-center align-middle">
                                <div class="btn-group" role="group">
                                    <a href="@Url.Action("Edit", new { id = item.Ma_Phieu_Giam_Gia })" class="btn btn-sm btn-outline-primary" title="Chỉnh sửa">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a href="@Url.Action("Details", new { id = item.Ma_Phieu_Giam_Gia })" class="btn btn-sm btn-outline-info mx-1" title="Chi tiết">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a href="@Url.Action("Delete", new { id = item.Ma_Phieu_Giam_Gia })" class="btn btn-sm btn-outline-danger" title="Xóa">
                                        <i class="fas fa-trash-alt"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>