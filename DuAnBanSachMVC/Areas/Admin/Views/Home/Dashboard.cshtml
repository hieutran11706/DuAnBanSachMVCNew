@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<style>
    :root {
        --primary-color: #5F9F90;
        --primary-hover: #4A8376;
        --dark-color: #2F3E46;
        --bg-light: #F8F9FA;
    }

    .page-title {
        font-weight: 700;
        color: var(--dark-color);
        border-left: 5px solid var(--primary-color);
        padding-left: 15px;
        text-transform: uppercase;
        font-size: 24px;
    }

    .card-stat {
        border: none;
        border-radius: 14px;
        box-shadow: 0 4px 25px rgba(0,0,0,0.03);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
        background-color: #fff;
    }

        .card-stat:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0,0,0,0.08);
        }

    .stat-icon {
        width: 54px;
        height: 54px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .icon-revenue {
        background-color: rgba(40, 167, 69, 0.1);
        color: #28a745;
    }

    .icon-books {
        background-color: rgba(220, 53, 69, 0.1);
        color: #dc3545;
    }

    .icon-orders {
        background-color: rgba(95, 159, 144, 0.1);
        color: var(--primary-color);
    }

    .icon-reviews {
        background-color: rgba(13, 110, 253, 0.1);
        color: #0d6efd;
    }

    .card-table {
        border: none;
        border-radius: 14px;
        box-shadow: 0 4px 25px rgba(0,0,0,0.03);
        background-color: #fff;
        overflow: hidden;
    }

    .table-dashboard th {
        background-color: var(--bg-light);
        color: #495057;
        font-weight: 600;
        text-transform: uppercase;
        font-size: 11px;
        letter-spacing: 0.8px;
        padding: 15px;
        border-bottom: 2px solid #E9ECEF;
    }

    .table-dashboard td {
        padding: 15px;
        vertical-align: middle;
        border-bottom: 1px solid #E9ECEF;
        font-size: 14px;
    }

    .review-box {
        transition: background-color 0.2s;
    }

        .review-box:hover {
            background-color: #F1F5F4 !important;
        }
</style>

<div class="container-fluid px-4 mt-4">

    <div class="mb-4">
        <h2 class="page-title m-0">Bảng Điều Khiển Hệ Thống</h2>
        <p class="text-muted m-0 mt-1">Tổng hợp tình hình kinh doanh thực tế của hệ thống sách chatBookora.</p>
    </div>

    <div class="row mb-2">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-stat h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Doanh thu tháng này</div>
                        <h3 class="fw-bold my-2 text-dark">@ViewBag.DoanhThuThang</h3>
                        <span class="text-success small fw-bold"><i class="fas fa-arrow-up me-1"></i>Thực tế</span> <span class="text-muted" style="font-size: 11px;">trong tháng</span>
                    </div>
                    <div class="stat-icon icon-revenue">
                        <i class="fas fa-wallet"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-stat h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Sách cần nhập kho</div>
                        <h3 class="fw-bold my-2 @(ViewBag.SoDauSachCanNhap > 0 ? "text-danger" : "text-dark")">@ViewBag.SoDauSachCanNhap đầu sách</h3>
                        <span class="text-muted" style="font-size: 11px;">Tồn kho dưới mức tối thiểu (10 cuốn)</span>
                    </div>
                    <div class="stat-icon icon-books">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-stat h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Đơn hàng chờ xử lý</div>
                        <h3 class="fw-bold my-2 text-dark">@ViewBag.DonHangChoXuLy đơn mới</h3>
                        @if (ViewBag.DonHangChoXuLy > 0)
                        {
                            <span class="badge bg-danger text-white rounded-pill px-2.5 py-1">Cần duyệt ngay</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-muted rounded-pill px-2.5 py-1">Đã xử lý hết</span>
                        }
                    </div>
                    <div class="stat-icon icon-orders">
                        <i class="fas fa-shopping-bag"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card card-stat h-100">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <div class="text-muted small text-uppercase fw-bold" style="font-size: 12px; letter-spacing: 0.5px;">Phản hồi hệ thống</div>
                        <h3 class="fw-bold my-2 text-dark">Đang hoạt động</h3>
                        <div class="text-muted small" style="font-size: 11px;">Ghi nhận đánh giá thời gian thực</div>
                    </div>
                    <div class="stat-icon icon-reviews">
                        <i class="fas fa-comments"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mb-5">
        <div class="col-lg-7 mb-4">
            <div class="card card-table h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark m-0" style="font-size: 16px;">
                        <i class="fas fa-box-open text-muted me-2"></i>Sách tồn kho thấp & Cần nhập thêm
                    </h5>
                    <a href="@Url.Action("Index", "Sach")" class="btn btn-sm btn-light border fw-semibold px-3" style="border-radius: 8px; font-size: 12px;">Xem kho</a>
                </div>
                <div class="card-body p-0 px-3 pb-3 mt-2">
                    <div class="table-responsive">
                        <table class="table table-dashboard table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Tên Đầu Sách</th>
                                    <th>Tác Giả</th>
                                    <th class="text-center">Tồn Kho</th>
                                    <th class="text-center">Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.DanhSachSachCanNhap != null && ((List<DuAnBanSachMVC.Models.Sach>)ViewBag.DanhSachSachCanNhap).Any())
                                {
                                    foreach (var item in (List<DuAnBanSachMVC.Models.Sach>)ViewBag.DanhSachSachCanNhap)
                                    {
                                        <tr>
                                            <td class="fw-bold text-dark">@item.Ten_Sach</td>
                                            <td class="text-secondary">@(item.Tac_Gia != null ? item.Tac_Gia.Ten_Tac_Gia : "Chưa cập nhật")</td>
                                            <td class="text-center fw-bold text-danger">@item.So_Luong_Ton</td>
                                            <td class="text-center">
                                                @if (item.So_Luong_Ton == 0)
                                                {
                                                    <span class="badge bg-danger px-2.5 py-1 text-white rounded-pill">Hết hàng</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning px-2.5 py-1 text-dark rounded-pill">Sắp hết</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="fas fa-check-circle text-success me-2"></i> Kho hàng an toàn, không có sách nào sắp hết!
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5 mb-4">
            <div class="card card-table h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark m-0" style="font-size: 16px;">
                        <i class="fas fa-user-clock text-muted me-2"></i>Khách hàng mới gia nhập
                    </h5>
                    <a href="@Url.Action("Index", "Khach_Hang")" class="btn btn-sm btn-light border fw-semibold px-3" style="border-radius: 8px; font-size: 12px;">Quản lý</a>
                </div>
                <div class="card-body p-3 mt-1">

                    @if (ViewBag.ThanhVienMoi != null && ((List<DuAnBanSachMVC.Models.Khach_Hang>)ViewBag.ThanhVienMoi).Any())
                    {
                        foreach (var user in (List<DuAnBanSachMVC.Models.Khach_Hang>)ViewBag.ThanhVienMoi)
                        {
                            <div class="p-3 mb-2 bg-light rounded review-box" style="border-left: 4px solid var(--primary-color);">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="fw-bold text-dark" style="font-size: 14px;"><i class="fas fa-user-circle me-1 text-secondary"></i> @user.Ho_Ten</span>
                                    <small class="text-muted" style="font-size: 12px;">@user.Ngay_Tao.ToString("dd/MM/yyyy")</small>
                                </div>
                                <div class="text-muted mt-1" style="font-size: 13px;">
                                    <div><i class="far fa-envelope me-1"></i> @user.Email</div>
                                    <div><i class="fas fa-phone-alt me-1" style="font-size: 11px;"></i> @(string.IsNullOrEmpty(user.So_Dien_Thoai) ? "Chưa cung cấp" : user.So_Dien_Thoai)</div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center p-5 text-muted">
                            <i class="fas fa-user-slash fa-2x mb-2 text-light"></i> <br />Chưa có thành viên mới đăng ký.
                        </div>
                    }

                </div>
            </div>
        </div>

        <div class="col-lg-12 mb-4">
            <div class="card card-table h-100">
                <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold text-dark m-0" style="font-size: 15px;">
                        <i class="fa-regular fa-comments text-muted me-2"></i>Phản hồi & Đánh giá gần đây
                    </h5>
                    <a href="@Url.Action("Index", "Danh_Gia", new { area = "Admin" })" class="btn btn-sm btn-light border fw-semibold px-3" style="border-radius: 8px; font-size: 12px;">Quản lý chung</a>
                </div>
                <div class="card-body p-3 mt-1">

                    @if (ViewBag.DanhGiaGanDay != null && ((List<DuAnBanSachMVC.Models.Danh_Gia>)ViewBag.DanhGiaGanDay).Any())
                    {
                        foreach (var review in (List<DuAnBanSachMVC.Models.Danh_Gia>)ViewBag.DanhGiaGanDay)
                        {
                            var khachHang = review.Chi_Tiet_Don_Hang?.Don_Hang?.Khach_Hang;

                            if (khachHang != null)
                            {
                                <div class="p-3 mb-3 bg-white rounded review-box shadow-sm" style="border-left: 4px solid var(--primary-color); border: 1px solid #E9ECEF; border-left-width: 4px; border-left-color: var(--primary-color);">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="fw-bold text-dark" style="font-size: 14px;">
                                            <i class="fa-regular fa-user me-1 text-secondary"></i> @khachHang.Ho_Ten
                                        </span>

                                        <div class="rating-stars" style="font-size: 12px; color: #ffc107;">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                if (i <= review.So_Sao)
                                                {
                                                    <i class="fas fa-star"></i>
                                                }
                                                else
                                                {
                                                    <i class="far fa-star text-muted"></i>
                                                }
                                            }
                                        </div>
                                    </div>

                                    <p class="text-muted font-italic mb-2" style="font-size: 13.5px; line-height: 1.4;">
                                        "@(string.IsNullOrEmpty(review.Binh_luan) ? "Người dùng chỉ để lại điểm đánh giá sao." : review.Binh_luan)"
                                    </p>

                                    <div class="d-flex justify-content-between align-items-center pt-1 border-top" style="font-size: 11px; color: #888;">
                                        <span><i class="fa-regular fa-envelope me-1"></i> @khachHang.Email</span>
                                        <span><i class="fa-regular fa-calendar-check me-1"></i> @review.Ngay_Danh_Gia.ToString("dd/MM/yyyy")</span>
                                    </div>
                                </div>
                            }
                        }
                    }
                    else
                    {
                        <div class="text-center p-5 text-muted">
                            <i class="fa-regular fa-comment-slash fa-2x mb-2 text-light"></i> <br />Hệ thống chưa ghi nhận bình luận hay đánh giá nào.
                        </div>
                    }

                </div>
            </div>
        </div>

    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center border-0 shadow-sm mb-5" role="alert" style="border-radius: 10px;">
            <i class="fas fa-exclamation-triangle me-3 fa-lg"></i>
            <div>
                <strong>Lỗi phát hiện cấu trúc dữ liệu:</strong> <code class="text-dark">@ViewBag.ErrorMessage</code>
            </div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

</div>