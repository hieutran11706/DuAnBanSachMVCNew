@model DuAnBanSachMVC.Models.The_Loai

@{
    ViewBag.Title = "Chỉnh Sửa Thể Loại";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<style>
    :root {
        --primary-color: #5F9F90;
        --primary-hover: #4A8376;
        --bg-light: #F4F8F7;
    }

    .page-title {
        font-weight: 700;
        color: #2F3E46;
        border-left: 5px solid var(--primary-color);
        padding-left: 15px;
        margin-bottom: 25px;
        text-transform: uppercase;
        font-size: 24px;
    }

    /* Khung bọc form giống trang Create */
    .form-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        background: #fff;
        padding: 30px;
        max-width: 700px;
    }

    .form-label-custom {
        font-weight: 600;
        color: #2F3E46;
        margin-bottom: 8px;
    }

    /* Custom input ô nhập liệu */
    .input-custom {
        border: 1.5px solid #E0E7E5 !important;
        border-radius: 8px !important;
        padding: 10px 15px !important;
        height: auto !important;
        transition: all 0.2s;
    }

        .input-custom:focus {
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 0.2rem rgba(95, 159, 144, 0.15) !important;
        }

    /* Nút lưu dữ liệu cập nhật */
    .btn-submit-custom {
        background-color: var(--primary-color) !important;
        color: #fff !important;
        border: none !important;
        border-radius: 20px !important;
        padding: 10px 25px !important;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-submit-custom:hover {
            background-color: var(--primary-hover) !important;
        }

    /* Nút quay lại */
    .btn-back {
        color: #666 !important;
        text-decoration: none;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        transition: color 0.2s;
    }

        .btn-back:hover {
            color: var(--primary-color) !important;
        }
</style>

<div class="container mt-4">
    <h2 class="page-title">Cập Nhật Thể Loại</h2>

    <div class="form-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                @Html.HiddenFor(model => model.Ma_The_Loai)

                <div class="form-group mb-4">
                    <label class="form-label-custom col-md-12">Tên Thể Loại</label>
                    <div class="col-md-12">
                        @Html.EditorFor(model => model.Ten_The_Loai, new { htmlAttributes = new { @class = "form-control input-custom", placeholder = "Nhập tên thể loại..." } })
                        @Html.ValidationMessageFor(model => model.Ten_The_Loai, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>
                </div>

                <div class="form-group mb-4">
                    <label class="form-label-custom col-md-12">Mô Tả Chi Tiết</label>
                    <div class="col-md-12">
                        @Html.EditorFor(model => model.Mo_Ta, new { htmlAttributes = new { @class = "form-control input-custom", placeholder = "Nhập mô tả..." } })
                        @Html.ValidationMessageFor(model => model.Mo_Ta, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>
                </div>

                <div class="form-group mt-4">
                    <div class="col-md-12 d-flex align-items-center justify-content-between">
                        <a href="@Url.Action("Index")" class="btn-back">
                            <i class="fa-solid fa-arrow-left me-2"></i> Quay lại danh sách
                        </a>

                        <button type="submit" class="btn btn-submit-custom">
                            <i class="fa-solid fa-floppy-disk me-1"></i> Lưu Thay Đổi
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}