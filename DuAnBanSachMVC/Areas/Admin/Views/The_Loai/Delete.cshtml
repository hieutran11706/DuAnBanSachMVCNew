@model DuAnBanSachMVC.Models.The_Loai

@{
    ViewBag.Title = "Xóa Thể Loại";
    Layout = "~/Areas/Admin/Views/Shared/AdminLayout.cshtml";
}

<style>
    :root {
        --primary-color: #5F9F90;
        --primary-hover: #4A8376;
        --danger-color: #D9534F;
        --danger-hover: #C9302C;
        --bg-light: #F4F8F7;
    }

    .page-title {
        font-weight: 700;
        color: #2F3E46;
        border-left: 5px solid var(--danger-color);
        padding-left: 15px;
        margin-bottom: 25px;
        text-transform: uppercase;
        font-size: 24px;
    }

    /* Khung bọc thông tin */
    .form-card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.05);
        background: #fff;
        padding: 30px;
        max-width: 700px;
    }

    .form-label-custom {
        font-weight: 600;
        color: #2F3E46;
        margin-bottom: 8px;
    }

    /* Vùng hiển thị text tĩnh nhưng vẫn giữ khung form cho đồng bộ */
    .display-custom {
        border: 1.5px solid #E0E7E5 !important;
        border-radius: 8px !important;
        padding: 10px 15px !important;
        background-color: var(--bg-light);
        color: #495057;
        min-height: 45px;
    }

    /* Nút xác nhận xóa */
    .btn-delete-custom {
        background-color: var(--danger-color) !important;
        color: #fff !important;
        border: none !important;
        border-radius: 20px !important;
        padding: 10px 25px !important;
        font-weight: 600;
        transition: background 0.2s;
    }

        .btn-delete-custom:hover {
            background-color: var(--danger-hover) !important;
        }

    /* Nút quay lại */
    .btn-back {
        color: #666 !important;
        text-decoration: none;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        transition: color 0.2s;
    }

        .btn-back:hover {
            color: var(--primary-color) !important;
        }
</style>

<div class="container mt-4">
    <h2 class="page-title">Xóa Thể Loại Sách</h2>
    <p class="text-muted mb-4 font-weight-bold">Bạn có chắc chắn muốn xóa thể loại này? Hành động này không thể hoàn tác.</p>

    <div class="form-card">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()

            <div class="form-horizontal">

                <!-- Hiển thị: Tên Thể Loại -->
                <div class="form-group mb-4">
                    <label class="form-label-custom col-md-12">Tên Thể Loại</label>
                    <div class="col-md-12">
                        <div class="display-custom">
                            @Html.DisplayFor(model => model.Ten_The_Loai)
                        </div>
                    </div>
                </div>

                <!-- Hiển thị: Mô Tả -->
                <div class="form-group mb-4">
                    <label class="form-label-custom col-md-12">Mô Tả Chi Tiết</label>
                    <div class="col-md-12">
                        <div class="display-custom">
                            @(string.IsNullOrEmpty(Model.Mo_Ta) ? "Chưa có mô tả chi tiết." : Model.Mo_Ta)
                        </div>
                    </div>
                </div>

                <!-- Hàng nút xử lý -->
                <div class="form-group mt-4">
                    <div class="col-md-12 d-flex align-items-center justify-content-between">
                        <!-- Nút quay lại danh sách -->
                        <a href="@Url.Action("Index")" class="btn-back">
                            <i class="fa-solid fa-arrow-left me-2"></i> Quay lại danh sách
                        </a>

                        <!-- Nút Xác nhận xóa thực sự -->
                        <button type="submit" class="btn btn-delete-custom">
                            <i class="fa-solid fa-trash-can me-1"></i> Xác Nhận Xóa
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>