@model DuAnBanSachMVC.Models.Sach
@{
    var dsYeuThich = ViewBag.DanhSachYeuThichIds as List<int>;
    bool isFav = dsYeuThich != null && dsYeuThich.Contains(Model.Ma_Sach);
    bool conHang = Model.So_Luong_Ton > 0;
}
<div class="book-card">

    <div class="book-image">

        <a href="@Url.Action("Detail","Home",new { id = Model.Ma_Sach })">
            <img src="@(string.IsNullOrEmpty(Model.Anh_Bia_Url)
                ? "https://via.placeholder.com/280x380?text=No+Image"
                : Model.Anh_Bia_Url)" alt="@Model.Ten_Sach" />
        </a>

        <div class="book-actions">
            <button type="button"
                    class="favorite-btn @(isFav ? "active" : "")"
                    data-masach="@Model.Ma_Sach"
                    title="Yêu thích">
                <i class="@(isFav ? "fa-solid" : "fa-regular") fa-heart"></i>
            </button>
        </div>

        <span class="book-badge @(!conHang ? "badge-out" : "")">
            @(conHang ? "Mới" : "Hết hàng")
        </span>

    </div>

    <div class="book-content">

        <h3><a href="@Url.Action("Detail","Home",new { id = Model.Ma_Sach })">@Model.Ten_Sach</a></h3>

        <p class="publisher">@(Model.Tac_Gia != null ? Model.Tac_Gia.Ten_Tac_Gia : Model.Nha_Xuat_Ban)</p>

        <div class="price">
            @Model.Gia_Ban.DinhDangTien()
        </div>

        @using (Html.BeginForm("ThemVaoGioHang", "Home", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <input type="hidden" name="maSach" value="@Model.Ma_Sach" />

            <input type="hidden" name="soLuong" value="1" />

            <button type="submit" class="cart-btn" @(conHang ? "" : "disabled")>
                <i class="fa-solid fa-cart-shopping"></i>
                Thêm vào giỏ
            </button>
        }

    </div>

</div>